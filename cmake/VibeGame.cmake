function(_vibe_platform_file out game_platform_dir relative)
    if(game_platform_dir AND EXISTS "${game_platform_dir}/${relative}")
        set(${out} "${game_platform_dir}/${relative}" PARENT_SCOPE)
    else()
        set(${out} "${VIBE_GAME_DIR}/platform/${relative}" PARENT_SCOPE)
    endif()
endfunction()

function(_vibe_filter_platform list_var root)
    set(files ${${list_var}})
    if(VIBE_APPLE)
        list(FILTER files EXCLUDE REGEX "^${root}/(platform|net/transport)/web/|^${root}/net/transport/(android|windows|linux)/")
    elseif(VIBE_ANDROID)
        list(FILTER files EXCLUDE REGEX "^${root}/(platform|net/transport)/web/|^${root}/net/transport/(apple|windows|linux)/")
    elseif(VIBE_WINDOWS)
        list(FILTER files EXCLUDE REGEX "^${root}/(platform|net/transport)/web/|^${root}/net/transport/(apple|android|linux)/")
    elseif(VIBE_LINUX)
        list(FILTER files EXCLUDE REGEX "^${root}/(platform|net/transport)/web/|^${root}/net/transport/(apple|android|windows)/")
    else()
        list(FILTER files EXCLUDE REGEX "^${root}/(platform/desktop|net/transport/(tcp|apple|android|windows|linux))/")
    endif()
    if(NOT VIBE_DEV_BUILD)
        list(FILTER files EXCLUDE REGEX "^${root}/(sdl/debug|ui/dev)/")
    endif()
    set(${list_var} ${files} PARENT_SCOPE)
endfunction()

# vibe_add_game(<target>
#     NAME <window and app name> ORG <org for the prefs path> ID <short id, session storage key>
#     BUNDLE_ID <reverse DNS id for macOS, iOS and Android>
#     [SOURCE_DIR <dir, default src>] [ASSETS_DIR <dir, default assets>] [PLATFORM_DIR <dir, default platform>]
#     [DEV_DIRS <dirs under SOURCE_DIR compiled into dev builds only>...]
#     [WEB_DEV_EXPORTS <extra C functions the dev page calls, like _my_dev_hook>...])
function(vibe_add_game target)
    cmake_parse_arguments(PARSE_ARGV 1 G "" "NAME;ORG;ID;BUNDLE_ID;SOURCE_DIR;ASSETS_DIR;PLATFORM_DIR"
        "DEV_DIRS;WEB_DEV_EXPORTS")
    foreach(required NAME ORG ID BUNDLE_ID)
        if(NOT G_${required})
            message(FATAL_ERROR "vibe_add_game(${target}): ${required} is required")
        endif()
    endforeach()
    if(NOT G_SOURCE_DIR)
        set(G_SOURCE_DIR src)
    endif()
    if(NOT G_ASSETS_DIR)
        set(G_ASSETS_DIR assets)
    endif()
    if(NOT G_PLATFORM_DIR)
        set(G_PLATFORM_DIR platform)
    endif()
    cmake_path(ABSOLUTE_PATH G_SOURCE_DIR BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
    cmake_path(ABSOLUTE_PATH G_ASSETS_DIR BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
    cmake_path(ABSOLUTE_PATH G_PLATFORM_DIR BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)

    set(VIBE_TARGET ${target})
    set(VIBE_APP_NAME "${G_NAME}")
    set(VIBE_APP_ORG "${G_ORG}")
    set(VIBE_APP_ID "${G_ID}")
    set(VIBE_BUNDLE_ID "${G_BUNDLE_ID}")
    set(VIBE_ASSETS_DIR "${G_ASSETS_DIR}")
    set(VIBE_GAME_PLATFORM_DIR "${G_PLATFORM_DIR}")

    file(GLOB_RECURSE lib_sources CONFIGURE_DEPENDS "${VIBE_LIB_DIR}/vibe/*.cpp" "${VIBE_LIB_DIR}/vibe/*.mm")
    _vibe_filter_platform(lib_sources "${VIBE_LIB_DIR}/vibe")
    file(GLOB_RECURSE game_sources CONFIGURE_DEPENDS "${G_SOURCE_DIR}/*.cpp" "${G_SOURCE_DIR}/*.mm")
    if(NOT VIBE_DEV_BUILD)
        foreach(dev_dir IN LISTS G_DEV_DIRS)
            list(FILTER game_sources EXCLUDE REGEX "^${G_SOURCE_DIR}/${dev_dir}/")
        endforeach()
    endif()
    set(sources ${lib_sources} ${game_sources})

    if(VIBE_APPLE)
        add_executable(${target} MACOSX_BUNDLE ${sources})
    elseif(VIBE_ANDROID)
        add_library(${target} SHARED ${sources})
    else()
        add_executable(${target} ${sources})
    endif()
    vibe_project_target(${target})
    vibe_sim_flags(${target})
    target_include_directories(${target} PRIVATE "${G_SOURCE_DIR}" "${VIBE_LIB_DIR}")
    target_compile_definitions(${target} PRIVATE
        VIBE_APP_NAME="${G_NAME}" VIBE_APP_ORG="${G_ORG}" VIBE_APP_ID="${G_ID}")
    target_link_libraries(${target} PRIVATE SDL3::SDL3 SDL3_ttf::SDL3_ttf nlohmann_json::nlohmann_json vibe_stb_vorbis)
    if(VIBE_DEV_BUILD)
        target_link_libraries(${target} PRIVATE vibe_imgui)
    endif()

    if(VIBE_ANDROID)
        include("${VIBE_GAME_DIR}/cmake/packaging/AndroidApk.cmake")
    elseif(VIBE_WINDOWS)
        include("${VIBE_GAME_DIR}/cmake/packaging/WindowsPackage.cmake")
    elseif(VIBE_LINUX)
        include("${VIBE_GAME_DIR}/cmake/packaging/LinuxPackage.cmake")
    elseif(VIBE_IOS)
        include("${VIBE_GAME_DIR}/cmake/packaging/IosBundle.cmake")
    elseif(VIBE_APPLE)
        include("${VIBE_GAME_DIR}/cmake/packaging/MacBundle.cmake")
    else()
        include("${VIBE_GAME_DIR}/cmake/packaging/WebPage.cmake")
    endif()
endfunction()

# The engine's pure net code (no SDL, no Emscripten) plus the game's protocol
# files, for decoder tests that run without a window.
#   vibe_add_net_pure(<target> SOURCE_DIR <game src> GAME_FILES <game .cpp files>...)
function(vibe_add_net_pure target)
    cmake_parse_arguments(PARSE_ARGV 1 P "" "SOURCE_DIR" "GAME_FILES")
    set(net "${VIBE_LIB_DIR}/vibe/net")
    set(files "${net}/Decode.cpp" "${net}/Encode.cpp" "${net}/Json.cpp" "${net}/Protocol.cpp" "${net}/TcpCodec.cpp" "${net}/Url.cpp" ${P_GAME_FILES})
    foreach(file IN LISTS files)
        file(STRINGS "${file}" bad_includes REGEX "#[ \t]*include[ \t]*[<\"](SDL|emscripten)")
        if(bad_includes)
            message(FATAL_ERROR "${file}: net decoders must not include SDL or Emscripten headers: ${bad_includes}")
        endif()
    endforeach()
    add_library(${target} STATIC ${files})
    vibe_project_target(${target})
    target_include_directories(${target} PUBLIC "${P_SOURCE_DIR}" "${VIBE_LIB_DIR}")
    target_link_libraries(${target} PUBLIC nlohmann_json::nlohmann_json)
endfunction()
