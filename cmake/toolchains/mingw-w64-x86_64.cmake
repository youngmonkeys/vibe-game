set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(VIBE_MINGW_PREFIX x86_64-w64-mingw32)
find_program(CMAKE_C_COMPILER ${VIBE_MINGW_PREFIX}-gcc REQUIRED)
find_program(CMAKE_CXX_COMPILER ${VIBE_MINGW_PREFIX}-g++ REQUIRED)
find_program(CMAKE_RC_COMPILER ${VIBE_MINGW_PREFIX}-windres REQUIRED)

get_filename_component(VIBE_MINGW_BIN "${CMAKE_CXX_COMPILER}" DIRECTORY)
get_filename_component(VIBE_MINGW_ROOT "${VIBE_MINGW_BIN}/../${VIBE_MINGW_PREFIX}" ABSOLUTE)
set(CMAKE_FIND_ROOT_PATH "${VIBE_MINGW_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
